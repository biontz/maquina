@@ -302,11 +302,21 @@ dispatchCurrentChildViewConfiguration(PuglView* const view)
   size_t                     dragTypeIndex;
   NSString*                  droppedUriList;
   bool                       reshaped;
+  double                     lastScaleFactor;
 }
 
 - (void)dispatchExpose:(NSRect)rect
 {
-  const double scaleFactor = [[NSScreen mainScreen] backingScaleFactor];
+  // the screen this view is on, not the main screen: they differ when a
+  // Retina and a non-Retina display are both connected
+  const double scaleFactor = [viewScreen(puglview) backingScaleFactor];
+
+  // a new scale (view put into a window on another screen, or the window
+  // moved there) is a new size in pixels: dispatch a configure first
+  if (scaleFactor != lastScaleFactor) {
+    lastScaleFactor = scaleFactor;
+    reshaped        = true;
+  }
 
   if (reshaped) {
     if (puglview->impl->window) {
@@ -362,6 +372,28 @@ dispatchCurrentChildViewConfiguration(PuglView* const view)
   reshaped = true;
 }
 
+// the window moved to a screen with another backing scale (Retina <-> non-
+// Retina): the size in pixels changed although the size in points did not,
+// so dispatch a new configure with the next expose and redraw everything
+- (void)viewDidChangeBackingProperties
+{
+  [super viewDidChangeBackingProperties];
+  reshaped = true;
+  [self setNeedsDisplay:YES];
+  [puglview->impl->drawView setNeedsDisplay:YES];
+}
+
+// embedded views are created before the host puts them into a window, so
+// their first scale is the main screen's: redraw (and so re-check the scale)
+// once the view is in its window
+- (void)viewDidMoveToWindow
+{
+  [super viewDidMoveToWindow];
+  reshaped = true;
+  [self setNeedsDisplay:YES];
+  [puglview->impl->drawView setNeedsDisplay:YES];
+}
