diff --git a/dgl/src/Window.cpp b/dgl/src/Window.cpp
index 6f7562e..0d706f2 100644
--- a/dgl/src/Window.cpp
+++ b/dgl/src/Window.cpp
@@ -411,6 +411,19 @@ uintptr_t Window::getNativeWindowHandle() const noexcept
 
 double Window::getScaleFactor() const noexcept
 {
+   #ifdef DISTRHO_OS_MAC
+    // macOS: the backing scale of the screen the view is on right now (it
+    // changes when the window moves between a Retina and a non-Retina screen,
+    // and an embedded view starts with the main screen's before the host
+    // puts it into its window)
+    if (pData->view != nullptr && std::getenv("DPF_SCALE_FACTOR") == nullptr)
+    {
+        const double scaleFactor = puglGetScaleFactor(pData->view);
+
+        if (scaleFactor > 0.0)
+            pData->scaleFactor = scaleFactor;
+    }
+   #endif
     return pData->scaleFactor;
 }
 
diff --git a/dgl/src/WindowPrivateData.cpp b/dgl/src/WindowPrivateData.cpp
index d7a3c93..59f08ea 100644
--- a/dgl/src/WindowPrivateData.cpp
+++ b/dgl/src/WindowPrivateData.cpp
@@ -646,6 +646,23 @@ void Window::PrivateData::onPuglConfigure(const uint width, const uint height)
 
     DGL_DBGp("PUGL: onReshape : %d %d\n", width, height);
 
+   #ifdef DISTRHO_OS_MAC
+    // macOS: the scale is the backing scale of the screen the view is on, and
+    // it changes when the window moves between a Retina and a non-Retina
+    // screen; pugl already reports sizes and pointer positions in the new
+    // scale, so keep ours in sync (host size conversions, NanoVG pixel ratio)
+    if (view != nullptr && getenv("DPF_SCALE_FACTOR") == nullptr)
+    {
+        const double newScaleFactor = puglGetScaleFactor(view);
+
+        if (newScaleFactor > 0.0 && d_isNotEqual(newScaleFactor, scaleFactor))
+        {
+            scaleFactor = newScaleFactor;
+            self->onScaleFactorChanged(newScaleFactor);
+        }
+    }
+   #endif
+
    #ifndef DPF_TEST_WINDOW_CPP
     createContextIfNeeded();
    #endif
