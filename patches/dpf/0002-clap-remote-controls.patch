         return fPlugin.getParameterCount();
     }
 
+   #if DISTRHO_PLUGIN_CLAP_REMOTE_CONTROLS
+    // ----------------------------------------------------------------------------------------------------------------
+    // remote controls
+
+    uint32_t getRemoteControlsPageCount() const
+    {
+        uint32_t count = 0;
+        d_clapRemotePages(&count);
+        return count;
+    }
+
+    bool getRemoteControlsPage(const uint32_t pageIndex, clap_remote_controls_page_t* const page) const
+    {
+        uint32_t count = 0;
+        const ClapRemotePage* const pages = d_clapRemotePages(&count);
+        DISTRHO_SAFE_ASSERT_RETURN(pages != nullptr && pageIndex < count, false);
+
+        std::memset(page, 0, sizeof(*page));
+        d_strncpy(page->section_name, fPlugin.getName(), CLAP_NAME_SIZE);
+        d_strncpy(page->page_name, pages[pageIndex].name, CLAP_NAME_SIZE);
+        page->page_id = pageIndex;
+        page->is_for_preset = false;
+
+        const uint32_t paramCount = fPlugin.getParameterCount();
+        for (uint32_t s = 0; s < CLAP_REMOTE_CONTROLS_COUNT; ++s)
+        {
+            page->param_ids[s] = CLAP_INVALID_ID;
+            if (const char* const symbol = pages[pageIndex].symbols[s])
+            {
+                for (uint32_t i = 0; i < paramCount; ++i)
+                {
+                    if (fPlugin.getParameterSymbol(i) == symbol)
+                    {
+                        page->param_ids[s] = i;
+                        break;
+                    }
+                }
+            }
+        }
+        return true;
+    }
+   #endif
