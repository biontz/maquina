+// Provided by the plugin: remote-control pages of 8 parameter symbols each (nullptr = empty slot).
+struct ClapRemotePage { const char* name; const char* symbols[8]; };
+extern const ClapRemotePage* d_clapRemotePages(uint32_t* count);
